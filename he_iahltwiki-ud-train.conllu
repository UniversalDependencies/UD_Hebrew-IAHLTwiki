# sent_id = iahltwiki_nuclear-73
# text = היות שלישראל יש מספר מועט של צוללות, המוגבלות בטווח הפעילות שלהן ובמספר הטילים שהן נושאות, יהיה זה בזבזני מבחינת כושר ההרתעה להשתמש בהן למכה ראשונה, אם כי, בשל הסיכונים הכרוכים בשיגור נשק גרעיני מתוך שטחה של המדינה, במיוחד בשל אחוזי הכישלון הגבוהים יחסית בעת שיגור השביט (שני כישלונות בשיגור לווייני "אופק", אם כי בתנאים קשים מאוד של שיגור אנכי וכנגד סיבוב כדור הארץ כדי למנוע את נפילת הלוויינים בשטח מדינות אויב) שעליו, על פי הערכות, מבוססים הטילים ארוכי הטווח של ישראל, קיימת אפשרות שישראל תשתמש בצוללות כבר במכה הראשונה של תרחיש קיצוני שבו היא תבחר להשתמש בנשק גרעיני.
